# EleGuard AI - Environment Variables
# Copy this file to .env and fill in your values

# =========================================================
# BACKEND (FastAPI)
# =========================================================

# Email alerts (Gmail SMTP) - REQUIRED for CRITICAL alerts
EMAIL_ENABLED=true
EMAIL_SENDER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_RECIPIENT=recipient-email@gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# CORS - comma-separated origins (no spaces)
# For production: https://your-frontend.onrender.com
# For local dev: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=https://eleguard-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Alert cooldowns (seconds)
SMS_COOLDOWN_SECONDS=60
SENSOR_STALE_SECONDS=8
ALERT_MODE_COOLDOWN_SECONDS=8

# Zone thresholds (0-1 normalized)
FOREST_LIMIT=0.45
VILLAGE_LIMIT=0.72

# =========================================================
# FRONTEND (Vite/React)
# =========================================================

# API base URL for frontend
# Local: http://127.0.0.1:8000
# Production: https://eleguard-backend.onrender.com
VITE_API_URL=https://eleguard-backend.onrender.com

# =========================================================
# AI DETECTION (detect_and_send.py)
# =========================================================

# API base URL for AI script
# Local: http://127.0.0.1:8000
# Production: https://eleguard-backend.onrender.com
API_BASE_URL=https://eleguard-backend.onrender.com

# =========================================================
# IoT SIMULATOR (simulator.py)
# =========================================================

# API base URL for IoT simulator
# Local: http://127.0.0.1:8000
# Production: https://eleguard-backend.onrender.com
API_BASE_URL=https://eleguard-backend.onrender.com

# =========================================================
# GMAIL APP PASSWORD SETUP
# =========================================================
# 1. Go to https://myaccount.google.com
# 2. Security → 2-Step Verification (turn ON)
# 3. Security → App passwords → Create new → Name: "EleGuard"
# 4. Copy the 16-character password (no spaces) to EMAIL_APP_PASSWORD
# 5. Use the same Gmail address for EMAIL_SENDER